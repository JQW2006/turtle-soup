# DeepSeek API (https://platform.deepseek.com). Used as the single default model when
# MODEL_PROFILES is not set; can also be configured from the Settings page.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: multiple model profiles (any OpenAI-compatible endpoint). Characters on the
# Characters page can each pick a profile; DEFAULT_MODEL picks the fallback for the rest.
# JSON array of {id, label, api_key, base_url, model}. Profiles saved in the Settings
# page (database) replace these entirely.
# MODEL_PROFILES=[{"id":"glm","label":"GLM","api_key":"x.y","base_url":"https://open.bigmodel.cn/api/paas/v4","model":"GLM-5.3"},{"id":"ds","label":"DeepSeek","api_key":"sk-","base_url":"https://api.deepseek.com","model":"deepseek-flash"}]
# DEFAULT_MODEL=glm

# Optional: require this token for every API request (recommended when the server is reachable from the internet).
APP_ACCESS_TOKEN=

# Optional: make the Settings page read-only. Set to true when the server is public without a token,
# otherwise visitors could replace the API key or redirect requests (and your key) to another server.
SETTINGS_LOCKED=false

# Optional: where the SQLite database lives (defaults to ./data/soup.db).
# DATABASE_URL=sqlite:////absolute/path/to/soup.db
