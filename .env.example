# DeepSeek API (https://platform.deepseek.com). Can also be set from the Settings page.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: require this token for every API request (recommended when the server is reachable from the internet).
APP_ACCESS_TOKEN=

# Optional: make the Settings page read-only. Set to true when the server is public without a token,
# otherwise visitors could replace the API key or redirect requests (and your key) to another server.
SETTINGS_LOCKED=false

# Optional: where the SQLite database lives (defaults to ./data/soup.db).
# DATABASE_URL=sqlite:////absolute/path/to/soup.db
